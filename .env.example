# Both the backend and the client read this single file at the repository root.
# The backend loads it via dotenv; Vite reads it via `envDir: '../'`.
# Do not create a .env inside backend/ or client/ — it will be ignored.

# Environment Mode (development / test / production)
NODE_ENV=development

# Backend Server Port (ignored on Vercel)
PORT=4000

# Database Connection (Local MongoDB or Cloud MongoDB Atlas)
MONGO_DB_URI=mongodb://127.0.0.1:27017/your_database_name

# CORS Allowed Origin for Client. Required in production.
CLIENT_URL=http://localhost:3000

# Backend API URL for Frontend (Vite).
# WARNING: anything prefixed VITE_ is compiled into the client bundle and is PUBLIC.
# In production set this to /api, because vercel.json only forwards /api/* to the function.
VITE_API_URL=http://localhost:4000

# Access token signing secret. Required. Minimum 32 characters in production.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# Refresh token signing secret. Must differ from JWT_SECRET so that a refresh token can
# never be replayed as an access token. Falls back to JWT_SECRET when unset, which is
# accepted in development and warned about in production.
JWT_REFRESH_SECRET=your_separate_refresh_secret_here

# JWT Token Expiration
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
